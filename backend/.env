APP_NAME=Rentora
APP_ENV=local
APP_KEY=base64:bDC+u4Ro6aCG2b9UPCDvvhIgX4sCsTRdQJk3ZEYaJFU=
APP_DEBUG=true
APP_TIMEZONE=America/Tegucigalpa
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@rentora.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage (S3 for prod)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Feature Flags
FEATURE_KYC_ENABLED=false
FEATURE_PAYMENTS_ENABLED=false

# Laravel Telescope (Local only)
TELESCOPE_ENABLED=true
